---
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import SearchBar from '../components/SearchBar.astro';
import LinkSection from '../components/LinkSection.astro';
import Logo from '../components/Logo.astro';
import {
  aiTools,
  imageTools,
  translateTools,
  adPlatforms,
  myServices,
} from '../data/links';
---

<Layout title="ie8.net — 起始页">
  <ThemeToggle />

  <div class="hero-band">
    <div class="hero-band-inner">
      <Logo large />
      <p class="tagline">你的浏览器起始页</p>
      <SearchBar />
    </div>
  </div>

  <nav class="cat-nav">
    <a href="#sec-tools">常用工具</a>
    <a href="#sec-ai">AI 工具</a>
    <a href="#sec-ad">广告平台</a>
  </nav>

  <div class="container">
    <section class="section" id="recent-section" hidden>
      <h2 class="section-title">最近访问</h2>
      <div class="link-grid" id="recent-grid"></div>
    </section>

    <section class="section" id="sec-tools">
      <h2 class="section-title">常用工具</h2>
      <div class="link-grid">
        {
          myServices.map((item) => (
            <a
              class="link-item"
              href={item.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="link-row">
                <span class="link-name">{item.name}</span>
              </span>
              {item.desc && <span class="link-desc">{item.desc}</span>}
            </a>
          ))
        }
      </div>
    </section>

    <LinkSection title="AI 工具" items={[...aiTools, ...imageTools, ...translateTools]} id="sec-ai" />

    <LinkSection title="广告平台" items={adPlatforms} id="sec-ad" />
  </div>

  <footer class="site-footer">
    <div class="site-footer-inner">
      <div>
        <div class="footer-brand">ie8.net</div>
        <div class="footer-note">你的浏览器起始页 · 收藏本页设为首页，一键直达常用服务与 AI 工具</div>
      </div>
      <div class="footer-links">
        <a href="#sec-tools">常用工具</a>
        <a href="#sec-ai">AI 工具</a>
        <a href="#sec-ad">广告平台</a>
      </div>
    </div>
  </footer>
</Layout>

<script>
  // --- Recent visits (client-side only, never leaves the browser) ---
  interface RecentVisit {
    name: string;
    href?: string;
    ts: number;
  }

  const RECENT_KEY = 'recentVisits';
  const RECENT_MAX = 8;
  const recentSection = document.getElementById('recent-section')!;
  const recentGrid = document.getElementById('recent-grid')!;

  function loadRecent(): RecentVisit[] {
    try {
      return JSON.parse(localStorage.getItem(RECENT_KEY) || '[]');
    } catch {
      return [];
    }
  }

  function saveRecent(list: RecentVisit[]) {
    localStorage.setItem(RECENT_KEY, JSON.stringify(list));
  }

  function escapeHtml(s: string) {
    return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  }

  function renderRecent() {
    const list = loadRecent();
    if (!list.length) {
      recentSection.hidden = true;
      return;
    }
    recentSection.hidden = false;
    recentGrid.innerHTML = list
      .map((item) => {
        const href = item.href
          ? `href="${escapeHtml(item.href)}" target="_blank" rel="noopener noreferrer"`
          : '';
        return `<a class="link-item" ${href}>
          <span class="link-row"><span class="link-name">${escapeHtml(item.name)}</span></span>
        </a>`;
      })
      .join('');
  }

  function recordVisit(entry: Omit<RecentVisit, 'ts'>) {
    const key = entry.href;
    if (!key) return;
    const list = loadRecent().filter((x) => x.href !== key);
    list.unshift({ ...entry, ts: Date.now() });
    saveRecent(list.slice(0, RECENT_MAX));
    renderRecent();
  }

  document.addEventListener('click', (e) => {
    const card = (e.target as HTMLElement).closest<HTMLElement>('.link-item');
    if (!card || recentGrid.contains(card)) return;
    const href = card.getAttribute('href') ?? undefined;
    if (!href) return;
    const name = card.querySelector('.link-name')?.textContent?.trim();
    if (!name) return;
    recordVisit({ name, href });
  });

  renderRecent();

  // --- Scroll-spy: highlight the current section in the anchor nav ---
  const navLinks = Array.from(document.querySelectorAll('.cat-nav a'));
  const navMap = new Map<string, HTMLElement>();
  navLinks.forEach((a) => {
    const id = a.getAttribute('href')?.slice(1);
    if (id) navMap.set(id, a as HTMLElement);
  });
  const sections = Array.from(document.querySelectorAll<HTMLElement>('.section[id]'));

  if ('IntersectionObserver' in window && sections.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            navLinks.forEach((l) => l.classList.remove('is-active'));
            navMap.get(entry.target.id)?.classList.add('is-active');
          }
        });
      },
      { rootMargin: '-45% 0px -50% 0px', threshold: 0 }
    );
    sections.forEach((s) => observer.observe(s));
  }
</script>
