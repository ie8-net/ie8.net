---
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import SearchBar from '../components/SearchBar.astro';
import LinkSection from '../components/LinkSection.astro';
import ToolTriggerCard from '../components/ToolTriggerCard.astro';
import Modal from '../components/Modal.astro';
import PasswordGenerator from '../components/PasswordGenerator.astro';
import QRGenerator from '../components/QRGenerator.astro';
import AddLinkForm from '../components/AddLinkForm.astro';
import Logo from '../components/Logo.astro';
import {
  aiTools,
  imageTools,
  translateTools,
  adPlatforms,
  myServices,
} from '../data/links';
---

<Layout title="ie8.net — 起始页">
  <ThemeToggle />

  <div class="hero-band">
    <div class="hero-band-inner">
      <Logo large />
      <p class="tagline">你的浏览器起始页</p>
      <SearchBar />
    </div>
  </div>

  <nav class="cat-nav">
    <a href="#sec-tools">常用工具</a>
    <a href="#sec-ai">AI 工具</a>
    <a href="#sec-img">图片生成</a>
    <a href="#sec-trans">翻译</a>
    <a href="#sec-ad">广告平台</a>
  </nav>

  <div class="container">
    <section class="section" id="recent-section" hidden>
      <h2 class="section-title">最近访问</h2>
      <div class="link-grid" id="recent-grid"></div>
    </section>

    <section class="section" id="sec-tools">
      <h2 class="section-title">常用工具</h2>
      <div class="link-grid">
        {
          myServices.map((item) => (
            <a
              class="link-item"
              href={item.url}
              target="_blank"
              rel="noopener noreferrer"
              style={`--c:${item.color ?? 'var(--accent)'}`}
            >
              <span class="link-row">
                <span class="link-dot"></span>
                <span class="link-name">{item.name}</span>
              </span>
              {item.desc && <span class="link-desc">{item.desc}</span>}
            </a>
          ))
        }
        <ToolTriggerCard name="密码生成器" desc="纯本地生成，不上传" color="#D97706" modalId="pwd" />
        <ToolTriggerCard name="二维码生成器" desc="文本 / 网址转二维码" color="#334155" modalId="qr" />
        <div id="custom-links-slot" style="display: contents;"></div>
        <ToolTriggerCard name="添加网址" desc="保存到本机浏览器" modalId="add-link" dashed />
      </div>
    </section>

    <LinkSection title="AI 工具" items={aiTools} id="sec-ai" />

    <LinkSection title="图片生成" items={imageTools} id="sec-img" />

    <LinkSection title="翻译" items={translateTools} id="sec-trans" />

    <LinkSection title="广告平台" items={adPlatforms} id="sec-ad" />
  </div>

  <Modal id="pwd" title="密码生成器">
    <PasswordGenerator />
  </Modal>

  <Modal id="qr" title="二维码生成器">
    <QRGenerator />
  </Modal>

  <Modal id="add-link" title="添加网址">
    <AddLinkForm />
  </Modal>
</Layout>

<script>
  import { monogram } from '../data/links';

  interface CustomLink {
    name: string;
    url: string;
  }

  const STORAGE_KEY = 'customLinks';
  const slot = document.getElementById('custom-links-slot')!;
  const form = document.getElementById('add-link-form') as HTMLFormElement;
  const nameInput = document.getElementById('add-link-name') as HTMLInputElement;
  const urlInput = document.getElementById('add-link-url') as HTMLInputElement;

  function load(): CustomLink[] {
    try {
      return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
    } catch {
      return [];
    }
  }

  function save(links: CustomLink[]) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(links));
  }

  function render() {
    const links = load();
    slot.innerHTML = links
      .map((link, i) => {
        const mono = monogram(link.name);
        return `
      <div class="link-item is-custom" style="--c:${mono.color}">
        <a class="link-main" href="${escapeAttr(link.url)}" target="_blank" rel="noopener noreferrer">
          <span class="link-row"><span class="link-dot"></span><span class="link-name">${escapeHtml(link.name)}</span></span>
        </a>
        <button type="button" class="link-remove" data-remove-link="${i}" aria-label="删除">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6 6 18" /></svg>
        </button>
      </div>`;
      })
      .join('');
  }

  function escapeHtml(s: string) {
    return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  }

  function escapeAttr(s: string) {
    return escapeHtml(s);
  }

  function normalizeUrl(raw: string) {
    const trimmed = raw.trim();
    if (!trimmed) return '';
    return /^https?:\/\//i.test(trimmed) ? trimmed : `https://${trimmed}`;
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = nameInput.value.trim();
    const url = normalizeUrl(urlInput.value);
    if (!name || !url) return;
    try {
      new URL(url);
    } catch {
      return;
    }
    const links = load();
    links.push({ name, url });
    save(links);
    render();
    form.reset();
    document.querySelector<HTMLElement>('[data-modal-id="add-link"]')?.setAttribute('hidden', '');
    document.body.style.overflow = '';
  });

  slot.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-remove-link]');
    if (!btn) return;
    const index = Number(btn.dataset.removeLink);
    const links = load();
    links.splice(index, 1);
    save(links);
    render();
  });

  render();

  // --- Recent visits (client-side only, never leaves the browser) ---
  interface RecentVisit {
    name: string;
    href?: string;
    modalId?: string;
    ts: number;
  }

  const RECENT_KEY = 'recentVisits';
  const RECENT_MAX = 8;
  const recentSection = document.getElementById('recent-section')!;
  const recentGrid = document.getElementById('recent-grid')!;

  function loadRecent(): RecentVisit[] {
    try {
      return JSON.parse(localStorage.getItem(RECENT_KEY) || '[]');
    } catch {
      return [];
    }
  }

  function saveRecent(list: RecentVisit[]) {
    localStorage.setItem(RECENT_KEY, JSON.stringify(list));
  }

  function renderRecent() {
    const list = loadRecent();
    if (!list.length) {
      recentSection.hidden = true;
      return;
    }
    recentSection.hidden = false;
    recentGrid.innerHTML = list
      .map((item) => {
        const mono = monogram(item.name);
        const tag = item.href ? 'a' : 'button';
        const attrs = item.href
          ? `href="${escapeAttr(item.href)}" target="_blank" rel="noopener noreferrer"`
          : `type="button" data-open-modal="${escapeAttr(item.modalId!)}"`;
        return `<${tag} class="link-item" ${attrs} style="--c:${mono.color}">
          <span class="link-row"><span class="link-dot"></span><span class="link-name">${escapeHtml(item.name)}</span></span>
        </${tag}>`;
      })
      .join('');
  }

  function recordVisit(entry: Omit<RecentVisit, 'ts'>) {
    const key = entry.href ?? entry.modalId;
    const list = loadRecent().filter((x) => (x.href ?? x.modalId) !== key);
    list.unshift({ ...entry, ts: Date.now() });
    saveRecent(list.slice(0, RECENT_MAX));
    renderRecent();
  }

  document.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('[data-remove-link]')) return;
    const card = (e.target as HTMLElement).closest<HTMLElement>('.link-item');
    if (!card || recentGrid.contains(card)) return;
    const modalId = card.dataset.openModal;
    if (modalId === 'add-link') return;
    const href = card.getAttribute('href') ?? undefined;
    if (!href && !modalId) return;
    const name = card.querySelector('.link-name')?.textContent?.trim();
    if (!name) return;
    recordVisit({ name, href, modalId });
  });

  renderRecent();
</script>
