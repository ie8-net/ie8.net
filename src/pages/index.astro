---
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import SearchBar from '../components/SearchBar.astro';
import LinkSection from '../components/LinkSection.astro';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import {
  aiTools,
  imageTools,
  translateTools,
  adPlatforms,
  myServices,
} from '../data/links';
---

<Layout title="ie8.net — 起始页">
  <aside class="sidebar">
    <a class="brand-home" href="/" aria-label="ie8.net 首页"><Logo /></a>
    <div class="sidebar-label">WORKSPACE</div>
    <nav class="side-nav" aria-label="分类导航">
      <a class="is-active" href="#top"><Icon name="home" />我的起始页<span>↗︎</span></a>
      <a href="#sec-tools"><Icon name="ip" />常用工具</a>
      <a href="#sec-ai"><Icon name="search" />AI 工具</a>
      <a href="#sec-ad"><Icon name="cms" />广告平台</a>
    </nav>
    <div class="sidebar-bottom"><div class="mini-mark">8</div><strong>少一点寻找，多一点创造。</strong><p>让每一次出发，都简单一点。</p><a href="https://github.com/ie8-net/ie8.net" target="_blank" rel="noopener noreferrer">GitHub ↗︎</a></div>
  </aside>
  <main id="top" class="workspace">
    <header class="topbar"><span>我的工作台 <span class="breadcrumb">/ 起始页</span></span><div class="topbar-actions"><span class="today" id="today"></span><ThemeToggle /></div></header>
    <div class="page-content">
      <section class="hero-band" aria-label="搜索">
        <div class="hero-band-inner">
          <div class="eyebrow"><span></span> YOUR DAILY STARTING POINT</div>
          <h1>好用的入口，<span>刚刚好。</span></h1>
          <p class="tagline">连接你的常用工具，把时间留给重要的事。</p>
          <SearchBar />
          <p class="search-hint"><kbd>/</kbd> 快速搜索 <span>·</span> 从这里，开启今天的灵感</p>
        </div>
        <div class="hero-orbit" aria-hidden="true"><svg viewBox="0 0 240 240"><ellipse cx="120" cy="120" rx="91" ry="43" transform="rotate(-40 120 120)"/><ellipse cx="120" cy="120" rx="91" ry="43" transform="rotate(40 120 120)"/><circle cx="120" cy="120" r="8"/></svg></div>
      </section>
      <div class="directory-header"><div><h2>探索你的工具箱</h2><p>精选常用服务，随时一键直达。</p></div><span class="directory-count">33 个精选入口 <span>↗︎</span></span></div>
      <nav class="cat-nav" aria-label="工具筛选">
        <button class="is-active" data-filter="all" aria-pressed="true">全部工具 <span>33</span></button>
        <button data-filter="sec-tools" aria-pressed="false">常用工具 <span>6</span></button>
        <button data-filter="sec-ai" aria-pressed="false">AI 工具 <span>18</span></button>
        <button data-filter="sec-ad" aria-pressed="false">广告平台 <span>9</span></button>
      </nav>
      <div class="container">
        <section class="section" id="recent-section" hidden><h2 class="section-title">最近访问</h2><div class="link-grid" id="recent-grid"></div></section>
        <LinkSection title="常用工具" items={myServices} id="sec-tools" />
        <LinkSection title="AI 工具" items={[...aiTools, ...imageTools, ...translateTools]} id="sec-ai" />
        <LinkSection title="广告平台" items={adPlatforms} id="sec-ad" />
      </div>
      <footer class="site-footer"><span>© {new Date().getFullYear()} ie8.net</span><span>简单一点，高效一点。<span class="footer-dot">●</span> 为日常而设计</span><a href="#top">回到顶部 ↑</a></footer>
    </div>
  </main>
</Layout>

<script>
  // --- Recent visits (client-side only, never leaves the browser) ---
  interface RecentVisit {
    name: string;
    href?: string;
    ts: number;
  }

  const RECENT_KEY = 'recentVisits';
  const RECENT_MAX = 8;
  const recentSection = document.getElementById('recent-section')!;
  const recentGrid = document.getElementById('recent-grid')!;

  function loadRecent(): RecentVisit[] {
    try {
      return JSON.parse(localStorage.getItem(RECENT_KEY) || '[]');
    } catch {
      return [];
    }
  }

  function saveRecent(list: RecentVisit[]) {
    localStorage.setItem(RECENT_KEY, JSON.stringify(list));
  }

  function escapeHtml(s: string) {
    return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  }

  function renderRecent() {
    const list = loadRecent();
    if (!list.length) {
      recentSection.hidden = true;
      return;
    }
    recentSection.hidden = false;
    recentGrid.innerHTML = list
      .map((item) => {
        const href = item.href
          ? `href="${escapeHtml(item.href)}" target="_blank" rel="noopener noreferrer"`
          : '';
        return `<a class="link-item" ${href}>
          <span class="link-row"><span class="link-name">${escapeHtml(item.name)}</span></span>
        </a>`;
      })
      .join('');
  }

  function recordVisit(entry: Omit<RecentVisit, 'ts'>) {
    const key = entry.href;
    if (!key) return;
    const list = loadRecent().filter((x) => x.href !== key);
    list.unshift({ ...entry, ts: Date.now() });
    saveRecent(list.slice(0, RECENT_MAX));
    renderRecent();
  }

  document.addEventListener('click', (e) => {
    const card = (e.target as HTMLElement).closest<HTMLElement>('.link-item');
    if (!card || recentGrid.contains(card)) return;
    const href = card.getAttribute('href') ?? undefined;
    if (!href) return;
    const name = card.querySelector('.link-name')?.textContent?.trim();
    if (!name) return;
    recordVisit({ name, href });
  });

  renderRecent();

  const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  filterButtons.forEach(button => button.addEventListener('click', () => {
    filterButtons.forEach(b => { b.classList.toggle('is-active', b === button); b.setAttribute('aria-pressed', String(b === button)); });
    document.querySelectorAll<HTMLElement>('.container > .section:not(#recent-section)').forEach(section => {
      section.hidden = button.dataset.filter !== 'all' && section.id !== button.dataset.filter;
    });
  }));
  document.querySelectorAll<HTMLAnchorElement>('.side-nav a').forEach(link => link.addEventListener('click', () => {
    const filter = link.hash === '#top' ? 'all' : link.hash.slice(1);
    document.querySelector<HTMLButtonElement>(`[data-filter="${filter}"]`)?.click();
    document.querySelectorAll('.side-nav a').forEach(a => a.classList.toggle('is-active', a === link));
  }));
  document.getElementById('today')!.textContent = new Intl.DateTimeFormat('zh-CN', { month: 'long', day: 'numeric', weekday: 'long' }).format(new Date());
  document.addEventListener('keydown', e => {
    if (e.key === '/' && !(e.target instanceof HTMLInputElement) && !(e.target instanceof HTMLTextAreaElement) && !(e.target as HTMLElement)?.isContentEditable) {
      e.preventDefault(); document.getElementById('search-input')?.focus();
    }
  });
</script>
