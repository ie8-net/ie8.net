---
interface Props {
  large?: boolean;
}

const { large = false } = Astro.props;
const size = large ? 40 : 26;
---

<div class={`logo ${large ? 'logo-lg' : ''}`}>
  <svg
    class="logo-mark"
    width={size}
    height={size * 1.25}
    viewBox="0 0 32 40"
    aria-hidden="true"
  >
    <circle cx="16" cy="12" r="10" class="logo-ring" />
    <circle cx="16" cy="28" r="10" class="logo-ring" />
  </svg>
  <span class="logo-word">ie<span class="logo-accent">8</span><span class="logo-muted">.net</span></span>
</div>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  .logo-mark {
    display: block;
  }

  .logo-ring {
    fill: none;
    stroke: var(--accent);
    stroke-width: 4.5;
    stroke-linecap: round;
  }

  .logo-word {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .logo-accent {
    color: var(--accent);
  }

  .logo-muted {
    color: var(--text-muted);
    font-weight: 500;
  }

  .logo-lg .logo-word {
    font-size: 58px;
    letter-spacing: -0.03em;
  }

  .logo-lg .logo-mark {
    width: 64px;
    height: 80px;
  }
</style>
