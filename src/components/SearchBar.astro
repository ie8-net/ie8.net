---
import { searchEngines } from '../data/links';
import Icon from './Icon.astro';
---

<div class="search-wrap">
  <form id="search-form" class="search-form" action={searchEngines[0].url} method="get">
    <div class="search-box">
      <input
        id="search-input"
        type="text"
        placeholder="输入关键词搜索…"
        autocomplete="off"
      />
      <button type="submit" class="search-submit" aria-label="搜索">
        <Icon name="search" />
      </button>
    </div>
    <div id="engine-tabs" class="engine-tabs">
      {
        searchEngines.map((engine, i) => (
          <button
            type="button"
            class="engine-tab"
            data-url={engine.url}
            data-active={i === 0 ? 'true' : 'false'}
          >
            {engine.name}
          </button>
        ))
      }
    </div>
  </form>
</div>

<style>
  .search-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    width: 100%;
  }

  .engine-tabs {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .engine-tab {
    border: none;
    background: transparent;
    color: var(--text-muted);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.02em;
    padding: 4px 1px;
    border-bottom: 1px solid transparent;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .engine-tab:hover {
    color: var(--text);
  }

  .engine-tab[data-active='true'] {
    color: var(--accent);
    border-bottom-color: var(--accent);
    font-weight: 500;
  }

  .search-box {
    width: 100%;
    max-width: 760px;
    display: flex;
    align-items: center;
    background: var(--bg-alt);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 8px 8px 8px 28px;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
  }

  .search-box:focus-within {
    background: var(--surface);
    border-color: var(--accent);
    box-shadow: var(--shadow-focus);
  }

  #search-input {
    flex: 1;
    border: none;
    background: transparent;
    outline: none;
    font-size: 23px;
    font-weight: 300;
    color: var(--text);
    padding: 25px 0;
  }

  .search-submit {
    width: 60px;
    height: 60px;
    border-radius: var(--radius);
    border: none;
    background: var(--accent);
    color: var(--accent-contrast);
    cursor: pointer;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: filter 0.15s ease;
  }

  .search-submit:hover {
    filter: brightness(1.06);
  }

  .search-submit :global(.icon) {
    width: 24px;
    height: 24px;
  }
</style>

<script is:inline>
  (function () {
    const form = document.getElementById('search-form');
    const input = document.getElementById('search-input');
    const tabs = document.getElementById('engine-tabs');
    const buttons = Array.from(tabs.querySelectorAll('.engine-tab'));

    const savedUrl = localStorage.getItem('searchEngineUrl');
    if (savedUrl) {
      buttons.forEach((b) => b.setAttribute('data-active', b.dataset.url === savedUrl ? 'true' : 'false'));
    }

    function activeUrl() {
      const active = buttons.find((b) => b.dataset.active === 'true');
      return active ? active.dataset.url : buttons[0].dataset.url;
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => b.setAttribute('data-active', 'false'));
        btn.setAttribute('data-active', 'true');
        localStorage.setItem('searchEngineUrl', btn.dataset.url);
        input.focus();
      });
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const q = input.value.trim();
      if (!q) return;
      window.location.href = activeUrl() + encodeURIComponent(q);
    });
  })();
</script>
