---
import BrandTile from './BrandTile.astro';
import type { LinkItem } from '../data/links';

interface Props {
  title: string;
  items: LinkItem[];
  id?: string;
  extraCount?: number;
}

const { title, items, id, extraCount = 0 } = Astro.props;
---

<section class="section" id={id}>
  <h2 class="section-title">{title}<span class="section-count">{(items.length + extraCount).toString().padStart(2, '0')}</span><span class="section-subtitle">{id === 'sec-services' ? '我们的服务，一站直达' : id === 'sec-tools' ? '日常所需，触手可及' : id === 'sec-ai' ? '让灵感与效率，一起发生' : '连接品牌与更多可能'}</span></h2>
  <div class="link-grid">
    {
      items.map((item) => (
        <a
          class="link-item"
          href={item.url}
          title={`${item.name} — ${item.desc || item.url}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          <BrandTile {...item} /><span class="link-main"><span class="link-row">
            <span class="link-name">{item.name}</span>
          </span>
          <span class="link-desc">{item.desc || new URL(item.url).hostname.replace('www.', '')}</span></span><span class="card-arrow" aria-hidden="true">↗︎</span>
        </a>
      ))
    }
    <slot />
  </div>
</section>
