---
interface Props {
  name: string;
  desc?: string;
  color?: string;
  modalId: string;
  dashed?: boolean;
}

const { name, desc, color, modalId, dashed = false } = Astro.props;
---

<button
  type="button"
  class={`link-item ${dashed ? 'is-dashed' : ''}`}
  data-open-modal={modalId}
>
  <span class="link-row">
    <span class="link-name">{name}</span>
  </span>
  {desc && <span class="link-desc">{desc}</span>}
</button>
